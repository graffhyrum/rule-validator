{
	"name": "@graff/rule-validator",
	"version": "1.0.1",
	"private": true,
	"license": "MIT",
	"bin": {
		"rule-validator": "./src/cli.ts"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./cli": "./dist/cli.js"
	},
	"scripts": {
		"build": "bun scripts/build.ts && bun run build:declaration",
		"build:declaration": "tsc --emitDeclarationOnly --project tsconfig.types.json",
		"postbuild": "bun run remove-buildinfo",
		"validate": "bun run src/cli.ts",
		"remove-buildinfo": "bun -e \"try{await Bun.file('tsconfig.types.tsbuildinfo').unlink()}catch{}\"",
		"dev": "bun run src/cli.ts",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:mutate": "stryker run",
		"typecheck": "tsc --noEmit",
		"lint:boundaries": "depcruise src",
		"check": "bunx oxlint . && bunx oxfmt --check .",
		"fix": "bunx oxlint --fix . && bunx oxfmt .",
		"custom-hooks": "stepdown-rule fix && rule-validator && crap4ts -c coverage/lcov.info -f lcov --exclude \"**/*.test.ts\"",
		"fastvet": "bun run build && bun typecheck && bun run lint:boundaries && bun fix && bun run test:coverage && bun run custom-hooks",
		"vet": "bun run fastvet"
	},
	"dependencies": {
		"arktype": "^2.2.5",
		"commander": "^15.0.0",
		"glob": "^13.0.6",
		"picocolors": "^1.1.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@graffhyrum/crap4ts": "github:graffhyrum/crap4ts",
		"@hughescr/stryker-bun-runner": "^1.4.0",
		"@stryker-mutator/core": "^10.0.0",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"dependency-cruiser": "^18.4.0",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"stepdown-rule": "github:graffhyrum/stepdown-rule"
	},
	"patchedDependencies": {
		"@hughescr/stryker-bun-runner@1.4.0": "patches/@hughescr+stryker-bun-runner@1.4.0.patch"
	}
}
