{
	"name": "@graff/rule-validator",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"bin": {
		"rule-validator": "./dist/cli.js"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./cli": "./dist/cli.js"
	},
	"scripts": {
		"build": "bun scripts/build.ts && bun run build:declaration",
		"build:declaration": "tsgo --emitDeclarationOnly --project tsconfig.types.json",
		"postbuild": "bun run remove-buildinfo",
		"validate": "bun run src/cli.ts",
		"remove-buildinfo": "bun -e \"try{await Bun.file('tsconfig.types.tsbuildinfo').unlink()}catch{}\"",
		"dev": "bun run src/cli.ts",
		"test": "bun test",
		"test:coverage": "bun run scripts/coverage-threshold.ts",
		"typecheck": "tsgo --noEmit",
		"check": "bunx oxlint . && bunx oxfmt --check .",
		"fix": "bunx oxlint --fix . && bunx oxfmt .",
		"custom-hooks": "bun scripts/run-stepdown.ts fix && bun run src/cli.ts",
		"fastvet": "bun run build && bun typecheck && bun fix && bun run custom-hooks && bun run test:coverage",
		"vet": "bun run fastvet"
	},
	"dependencies": {
		"arktype": "^2.2.3",
		"commander": "^14.0.3",
		"glob": "^13.0.6",
		"picocolors": "^1.1.1",
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.5",
		"oxfmt": "^0.38.0",
		"oxlint": "^1.75.0",
		"stepdown-rule": "github:graffhyrum/stepdown-rule"
	},
	"peerDependencies": {
		"@typescript/native-preview": "^7.0.0-dev.20260219.1"
	}
}
