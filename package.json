{
	"name": "@graff/rule-validator",
	"version": "1.1.2",
	"private": true,
	"license": "MIT",
	"bin": {
		"rule-validator": "./src/cli.ts"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./cli": "./dist/cli.js"
	},
	"scripts": {
		"build": "bun scripts/build.ts && bun run build:declaration",
		"build:declaration": "tsc --emitDeclarationOnly --project tsconfig.types.json",
		"postbuild": "bun run remove-buildinfo",
		"validate": "bun run src/cli.ts",
		"remove-buildinfo": "bun -e \"try{await Bun.file('tsconfig.types.tsbuildinfo').unlink()}catch{}\"",
		"dev": "bun run src/cli.ts",
		"test": "bun test",
		"test:coverage": "bun run scripts/coverage-threshold.ts",
		"typecheck": "tsc --noEmit",
		"check": "bunx oxlint . && bunx oxfmt --check .",
		"fix": "bunx oxlint --fix . && bunx oxfmt .",
		"custom-hooks": "bun scripts/run-stepdown.ts fix && bun run src/cli.ts",
		"fastvet": "bun run build && bun typecheck && bun fix && bun run custom-hooks && bun run test:coverage",
		"vet": "bun run fastvet",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "changeset tag && git push origin --follow-tags",
		"crap": "bun test --coverage --coverage-reporter=lcov && bunx crap4ts -c coverage/lcov.info -f lcov --exclude \"**/*.test.ts\""
	},
	"dependencies": {
		"arktype": "^2.2.9",
		"commander": "^15.0.0",
		"glob": "^13.0.6",
		"picocolors": "^1.1.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@graffhyrum/crap4ts": "github:graffhyrum/crap4ts",
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"stepdown-rule": "github:graffhyrum/stepdown-rule"
	}
}
