{
	"version": 1,
	"hooks": {
		"sessionStart": [
			{
				"command": "bun .cursor/hooks/cm-session-start.ts"
			}
		],
		"beforeShellExecution": [
			{
				"command": "bun .cursor/hooks/dcg-guard.ts",
				"failClosed": true,
				"timeout": 30
			}
		],
		"afterFileEdit": [
			{
				"command": "bun .cursor/hooks/ubs-after-edit.ts"
			}
		],
		"stop": [
			{
				"command": "bun .cursor/hooks/stop.ts"
			}
		]
	}
}
